# =====================================================================
#  Mau cau hinh moi truong - COPY FILE NAY THANH `.env` ROI SUA
#      cp .env.example .env
#  File `.env` KHONG duoc commit len git (da co trong .gitignore).
# =====================================================================

# --------------------------- MySQL -----------------------------------
# Ban tu chon hostname/username/password o day.
MYSQL_ROOT_PASSWORD=doi_mat_khau_root_nay
DB_NAME=webtro
DB_USERNAME=webtro_user
DB_PASSWORD=doi_mat_khau_nay
# Cong mo ra may that. Dung 3307 de khong dung do voi MySQL da cai san (3306).
MYSQL_EXPOSED_PORT=3307

# --------------------------- Redis -----------------------------------
REDIS_PASSWORD=doi_mat_khau_redis_nay
REDIS_EXPOSED_PORT=6380

# ---------------------------- JWT ------------------------------------
# BAT BUOC. Toi thieu 32 byte. Sinh chuoi ngau nhien:
#   Linux/macOS : openssl rand -base64 48
#   Windows PS  : [Convert]::ToBase64String((1..48|%{Get-Random -Max 256}))
JWT_SECRET=THAY_BANG_CHUOI_NGAU_NHIEN_DAI_IT_NHAT_32_BYTE_KHONG_DUNG_GIA_TRI_NAY
JWT_ISSUER=webtro-api
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P1D

# ------------------------- Thanh toan --------------------------------
# SANDBOX = cong thanh toan mo phong (tai lieu nghiep vu 13.2).
PAYMENT_PROVIDER=SANDBOX
PAYMENT_CALLBACK_SECRET=THAY_BANG_CHUOI_NGAU_NHIEN_KHAC
PAYMENT_RETURN_URL=http://localhost/quan-ly/thanh-toan/ket-qua

# --------------------- Tai khoan quan tri khoi tao --------------------
# Duoc tao tu dong luc khoi dong neu chua ton tai.
ADMIN_SEED_ENABLED=true
ADMIN_EMAIL=admin@webtro.local
ADMIN_PASSWORD=Admin@12345
ADMIN_FULL_NAME=Quan tri he thong
ADMIN_PHONE=0900000000

# ---------------------------- Mail -----------------------------------
# Mac dinh dung MailHog trong compose: xem mail tai http://localhost:8025
MAIL_ENABLED=true
MAIL_FROM_ADDRESS=no-reply@webtro.local
MAIL_FROM_NAME=Webtro
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# --------------------------- Cong mo ---------------------------------
BACKEND_EXPOSED_PORT=8080
FRONTEND_EXPOSED_PORT=80
SENTIMENT_API_EXPOSED_PORT=5000
RECOMMENDATION_API_EXPOSED_PORT=8001
RENTAL_API_EXPOSED_PORT=8002
AI_PORTAL_EXPOSED_PORT=8501
CHATBOT_API_EXPOSED_PORT=8081
CHATBOT_NLU_EXPOSED_PORT=8003

# --------------------------- Frontend --------------------------------
# "/api" -> goi qua reverse proxy Nginx cua chinh frontend.
VITE_API_BASE_URL=/api
VITE_APP_NAME=Webtro
FRONTEND_BASE_URL=http://localhost
STORAGE_PUBLIC_BASE_URL=http://localhost/api/files
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173

# ----------------------------- Khac ----------------------------------
SWAGGER_ENABLED=true
RATE_LIMIT_ENABLED=true
SCHEDULER_ENABLED=true

# --------------------------- AI modules -------------------------------
# Sentiment API      : http://localhost:5000
# Recommendation API : http://localhost:8001
# Rental price API   : http://localhost:8002
# AI portal          : http://localhost:8501
# Chatbot API        : http://localhost:8081
# Chatbot NLU        : http://localhost:8003

# Chatbot module dung database rieng trong compose tong de khong lam lech schema webtro.
CHATBOT_DB_ROOT_PASSWORD=root
CHATBOT_DB_NAME=roomfinder
CHATBOT_DB_USER=root
CHATBOT_DB_PASSWORD=root
CHATBOT_NLU_ENABLED=true
CHATBOT_GEOCODING_ENABLED=true

# Khong bat buoc. De trong thi chatbot fallback rule-based/template khi LLM khong kha dung.
GEMINI_API_KEY=
